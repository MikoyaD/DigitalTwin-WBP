<launch>
    <include file="$(find cr5_car_moveit)/launch/demo_gazebo.launch">
      <arg name="bridge_listen_topic" value="/qp_optimized_trajectory" />
      <arg name="enable_old_collector" value="false" />
      <arg name="world_name" value="$(find aws_robomaker_small_warehouse_world)/worlds/no_roof_small_warehouse.world" />
    </include>

  <!-- 使用 experiment.launch 中的静态地图作为八叉树障碍（不启动 experiment 的其它任务） -->
  <node pkg="pcl_ros" type="pcd_to_pointcloud" name="visual_map_publisher" args="/home/robot/digitaltwin/zzs_ws/src/cr5_car_moveit/map/warehouse.pcd 0.2">
    <param name="frame_id" type="string" value="odom" />
    <remap from="cloud_pcd" to="/visual_hologram_map" />
  </node>

  <node pkg="octomap_server" type="octomap_server_node" name="octomap_talker" args="/home/robot/digitaltwin/zzs_ws/src/cr5_car_moveit/map/warehouse_cropped.bt">
    <param name="frame_id" type="string" value="odom" />
  </node>

  <node pkg="cr5_car_moveit" type="load_static_octomap.py" name="load_static_octomap" output="screen" />

  <!-- 覆盖 sensors 配置，避免影响全局静态地图读取 -->
  <rosparam param="/move_group/sensors">[]</rosparam>

  <!-- demo_1goal_qp 的主流程（单目标规划 + QP 优化拦截 + 数据记录） -->
  <node name="rviz_qp_interceptor" pkg="cr5_car_moveit" type="execute_1goal_qp.py" output="screen" launch-prefix="bash -c 'sleep 10; $0 $@' " />

  <!-- Dump raw OMPL waypoint sets (original plan points) -->
  <node name="ompl_waypoints" pkg="cr5_car_moveit" type="ompl_waypoints.py" output="screen" launch-prefix="bash -c 'sleep 6; $0 $@' " />

  <node name="thesis_data_collector_totg" pkg="cr5_car_moveit" type="get_data_1goal_qp.py" output="screen" launch-prefix="bash -c 'sleep 12; $0 $@' ">
      <remap from="/qp_optimized_trajectory" to="/move_group/display_planned_path"/>
  </node>

  <node name="thesis_data_collector_qp" pkg="cr5_car_moveit" type="get_data_1goal_qp.py" output="screen" launch-prefix="bash -c 'sleep 13; $0 $@' " />

</launch>