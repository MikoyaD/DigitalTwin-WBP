<launch>
  <group>
    <remap from="/realsense/depth/points_no_ground" to="/void_blackhole_cloud" />
    <include file="$(find cr5_car_moveit)/launch/demo.launch">
      <arg name="load_robot_description" value="true"/>
      <arg name="fake_execution_type" value="true"/>
    </include>
  </group>

  <node name="joint_state_publisher" pkg="joint_state_publisher" type="joint_state_publisher">
    <param name="use_gui" value="false"/>
    <rosparam param="source_list">[/move_group/fake_controller_joint_states]</rosparam>
  </node>
  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" />
  <node pkg="tf2_ros" type="static_transform_publisher" name="world_to_odom" args="0 0 0 0 0 0 world odom" />
  <node pkg="tf2_ros" type="static_transform_publisher" name="odom_to_car" args="0 0 0 0 0 0 odom car_link" />

  <node pkg="pcl_ros" type="pcd_to_pointcloud" name="visual_map_publisher" args="/home/robot/digitaltwin/zzs_ws/src/cr5_car_moveit/map/warehouse_cropped.pcd 0.2">
    <param name="frame_id" type="string" value="odom" />
    <remap from="cloud_pcd" to="/visual_hologram_map" />
  </node>

  <node pkg="cr5_car_moveit" type="record_waypoints.py" name="waypoint_recorder" output="screen" required="true" />
</launch>