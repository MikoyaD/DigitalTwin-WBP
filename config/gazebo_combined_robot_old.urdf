        <origin xyz="0.1309 -0.21881 0.095" rpy="0 0 -0.44291" />
        <parent link="car_link" />
        <child link="sonar_forward_right_link" />
        <axis xyz="0 0 0" />
    </joint>
    <!-- 轮子摩擦系数设置 -->
    <gazebo reference="wheel_left_link">
        <mu1 value="200.0" />
        <mu2 value="100.0" />
        <kp value="10000000.0" />
        <kd value="1.0" />
        <material>Gazebo/Grey</material>
        <plugin name="gazebo_ros_control" filename="libgazebo_ros_control.so">
            <robotNamespace>/</robotNamespace>
        </plugin>
    </gazebo>
    <gazebo reference="wheel_right_link">
        <mu1 value="200.0" />
        <mu2 value="100.0" />
        <kp value="10000000.0" />
        <kd value="1.0" />
        <material>Gazebo/Grey</material>
    </gazebo>
    <gazebo reference="ball_left_link">
        <mu1 value="0.0" />
        <mu2 value="0.0" />
        <kp value="10000000.0" />
        <kd value="1.0" />
        <material>Gazebo/Grey</material>
    </gazebo>
    <gazebo reference="ball_right_link">
        <mu1 value="0.0" />
        <mu2 value="0.0" />
        <kp value="10000000.0" />
        <kd value="1.0" />
        <material>Gazebo/Grey</material>
    </gazebo>
    <!-- 主动轮差速驱动设置 -->
    <gazebo>
        <plugin name="differential_drive_controller" filename="libgazebo_ros_diff_drive.so">
            <alwaysOn>true</alwaysOn>
            <updateRate>50</updateRate>
            <legacyMode>true</legacyMode>
            <leftJoint>wheel_left_joint</leftJoint>
            <rightJoint>wheel_right_joint</rightJoint>
            <wheelSeparation>0.3935</wheelSeparation>
            <wheelDiameter>0.12</wheelDiameter>
            <torque>20</torque>
            <commandTopic>cb_robot_description/control/cmd_vel_sim</commandTopic>
            <odometryTopic>cb_robot_description/hardware/odom_sim</odometryTopic>
            <odometryFrame>odom</odometryFrame>
            <robotBaseFrame>car_link</robotBaseFrame>
            <publishWheelTF>false</publishWheelTF>
            <publishWheelJointState>false</publishWheelJointState>
            <publishOdomTF>false</publishOdomTF>
            <rosDebugLevel>na</rosDebugLevel>
            <wheelAcceleration>0</wheelAcceleration>
            <wheelTorque>20</wheelTorque>
            <odometrySource>world</odometrySource>
            <publishTf>1</publishTf>
        </plugin>
    </gazebo>
    <!-- 雷达设置 -->
    <gazebo reference="lidar_link">
        <sensor type="ray" name="lidar">
            <pose>0 0 0 0 0 0</pose>
            <visualize>true</visualize>
            <update_rate>20</update_rate>
            <ray>
                <scan>
                    <horizontal>
                        <samples>1200</samples>
                        <resolution>1</resolution>
                        <min_angle>-5.06145</min_angle>
                        <max_angle>-1.22173</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.1</min>
                    <max>30.0</max>
                    <resolution>0.03</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.01</stddev>
                </noise>
            </ray>
            <plugin name="laser_controller" filename="libgazebo_ros_laser.so">
                <topicName>cb_robot_description/hardware/lidar/scan</topicName>
                <frameName>lidar_link</frameName>
            </plugin>
        </sensor>
    </gazebo>
    <!-- IMU 设置 -->
    <gazebo reference="car_link">
        <gravity>true</gravity>
        <sensor name="imu_sensor" type="imu">
            <always_on>true</always_on>
            <update_rate>50</update_rate>
            <visualize>true</visualize>
            <topic>__default_topic__</topic>
            <plugin filename="libgazebo_ros_imu_sensor.so" name="imu_plugin">
                <topicName>cb_robot_description/hardware/imu</topicName>
                <bodyName>car_link</bodyName>
                <updateRateHZ>50.0</updateRateHZ>
                <gaussianNoise>0.0</gaussianNoise>
                <xyzOffset>0 0 0</xyzOffset>
                <rpyOffset>0 0 0</rpyOffset>
                <frameName>car_link</frameName>
                <initialOrientationAsReference>true</initialOrientationAsReference>
            </plugin>
            <pose>0 0 0 0 0 0</pose>
        </sensor>
    </gazebo>
    <!-- 超声波设置 -->
    <gazebo reference="sonar_forward_left_link">
        <sensor type="ray" name="ultrasonic_sensor_forward_left_link">
            <pose>0 0 0 0 0 0</pose>
            <visualize>false</visualize>
            <update_rate>20</update_rate>
            <ray>
                <scan>
                    <horizontal>
                        <samples>5</samples>
                        <resolution>1</resolution>
                        <min_angle>-0.1</min_angle>
                        <max_angle>0.1</max_angle>
                    </horizontal>
                    <vertical>
                        <samples>5</samples>
                        <resolution>1</resolution>
                        <min_angle>-0.1</min_angle>
                        <max_angle>0.1</max_angle>
                    </vertical>
                </scan>
                <range>
                    <min>0.1</min>
                    <max>3</max>
                    <resolution>0.01</resolution>
                </range>
            </ray>
            <plugin name="ultrasonic_sensor_controller_forward_left_link" filename="libgazebo_ros_range.so">
                <updateRate>20</updateRate>
                <gaussianNoise>0.01</gaussianNoise>
                <alwaysOn>true</alwaysOn>
                <fov>0.26</fov>
                <topicName>cb_robot_description/hardware/sonar/forward_left</topicName>
                <frameName>sonar_forward_left_link</frameName>
                <radiation>ultrasound</radiation>
            </plugin>
        </sensor>
    </gazebo>
    <gazebo reference="sonar_forward_mid_left_link">
