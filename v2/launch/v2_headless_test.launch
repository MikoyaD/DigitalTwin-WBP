<launch>
  <arg name="default_workspace_bounds" default="10.0"/>
  <arg name="static_octomap" default="$(find cr5_car_moveit)/map/warehouse_cropped.bt"/>
  <!-- Dedicated ROS master required. Never include old bridge, QP, collector or RViz. -->
  <param name="/use_sim_time" value="false" />
  <include file="$(find cr5_car_moveit)/launch/planning_context.launch">
    <arg name="load_robot_description" value="true" />
  </include>
  <group ns="move_group/planning_pipelines">
    <include file="$(find cr5_car_moveit)/launch/planning_pipeline.launch.xml">
      <arg name="pipeline" value="ompl" />
    </include>
  </group>
  <node pkg="tf2_ros" type="static_transform_publisher" name="v2_world_to_odom" args="0 0 0 0 0 0 world odom" output="screen" />
  <node pkg="robot_state_publisher" type="robot_state_publisher" name="v2_robot_state_publisher" output="screen" />
  <node pkg="octomap_server" type="octomap_server_node" name="v2_octomap_server" args="$(arg static_octomap)" output="screen">
    <param name="frame_id" value="odom" />
  </node>
  <node pkg="moveit_ros_move_group" type="move_group" name="move_group" output="screen" required="true">
    <param name="default_workspace_bounds" value="$(arg default_workspace_bounds)" type="double"/>
    <param name="planning_pipelines/ompl/default_workspace_bounds" value="$(arg default_workspace_bounds)" type="double"/>
    <param name="allow_trajectory_execution" value="false" />
    <param name="default_planning_pipeline" value="ompl" />
    <param name="publish_monitored_planning_scene" value="true" />
    <param name="planning_scene_monitor/publish_planning_scene" value="true" />
    <param name="planning_scene_monitor/publish_geometry_updates" value="true" />
    <param name="planning_scene_monitor/publish_state_updates" value="true" />
    <param name="planning_scene_monitor/publish_transforms_updates" value="true" />
  </node>
</launch>
